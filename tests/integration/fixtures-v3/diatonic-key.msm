<?xml version="1.0"?>
<!--
  spec-derived, MPM develop @ 1de00bb, DESIGN.md D8 (interval.diatonic), arithmetic in
  ornamentation-v3.test.ts

  Hand-authored (NOT generated by the Java reference, which has no v3 support). Structural
  idiom copied from tests/integration/fixtures/all-maps-reference/ornamentation.msm; the
  keySignature shape is the one the MEI converter writes and the one
  tests/integration/fixtures/performance-reference/instruments_augmented.msm carries — one
  <accidental> per altered pitch, `value` in semitones (1.0 sharp, −1.0 flat).

  Two sharps = D major. P is D5 (74), chosen because the steps the ornament asks for land on
  F♯ and C♯ — notes a key-blind (C major) reading would put a semitone lower.
-->
<msm title="v3 diatonic intervals in D major" xml:id="v3-diatonic-key" pulsesPerQuarter="720">
  <global>
    <header />
    <dated>
      <timeSignatureMap />
      <keySignatureMap />
      <markerMap />
      <sectionMap>
        <section date="0.0" date.end="2880.0" xml:id="sec1" />
      </sectionMap>
      <phraseMap />
      <sequencingMap />
      <pedalMap />
      <miscMap />
    </dated>
  </global>
  <part name="Piano" number="1" midi.channel="0" midi.port="0">
    <header />
    <dated>
      <timeSignatureMap>
        <timeSignature date="0.0" numerator="4.0" denominator="4" />
      </timeSignatureMap>
      <keySignatureMap>
        <keySignature date="0.0">
          <accidental midi.pitch="6.0" pitchname="F" value="1.0" />
          <accidental midi.pitch="1.0" pitchname="C" value="1.0" />
        </keySignature>
      </keySignatureMap>
      <markerMap />
      <sequencingMap />
      <pedalMap />
      <phraseMap />
      <miscMap>
        <tupletSpanMap />
      </miscMap>
      <score>
        <note xml:id="P" date="0.0" midi.pitch="74.0" pitchname="d" accidentals="0.0" octave="4.0" duration="1440.0" />
        <note xml:id="q" date="1440.0" midi.pitch="69.0" pitchname="a" accidentals="0.0" octave="4.0" duration="1440.0" />
      </score>
    </dated>
  </part>
</msm>
