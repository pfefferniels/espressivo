<?xml version="1.0"?>
<!--
  spec-derived, MPM develop @ 1de00bb, DESIGN.md D6 (the v2 path is byte-frozen), arithmetic in
  ornamentation-v3.test.ts

  Hand-authored (NOT generated by the Java reference — the Java reference DOES cover this
  document's semantics, in tests/integration/fixtures/all-maps-reference/ornamentation.{msm,
  mpm}, and this fixture deliberately does not copy those bytes: the immutable Java-verified
  pair keeps proving parity, while this one proves that the *new* suite, driving the *new*
  code, still takes a v2 document down the v2 path).

  Two arpeggiated chords. The first is at 1440 rather than at 0 so that the earliest shifted
  onset (−22 ticks) still lands at a positive date, which keeps the millisecond assertions
  plain tempo arithmetic.
-->
<msm title="v2 ornamentation through the v3 build" xml:id="v3-v2-passthrough" pulsesPerQuarter="720">
  <global>
    <header />
    <dated>
      <timeSignatureMap />
      <keySignatureMap />
      <markerMap />
      <sectionMap>
        <section date="0.0" date.end="4320.0" xml:id="sec1" />
      </sectionMap>
      <phraseMap />
      <sequencingMap />
      <pedalMap />
      <miscMap />
    </dated>
  </global>
  <part name="Piano" number="1" midi.channel="0" midi.port="0">
    <header />
    <dated>
      <timeSignatureMap>
        <timeSignature date="0.0" numerator="4.0" denominator="4" />
      </timeSignatureMap>
      <keySignatureMap />
      <markerMap />
      <sequencingMap />
      <pedalMap />
      <phraseMap />
      <miscMap>
        <tupletSpanMap />
      </miscMap>
      <score>
        <note xml:id="a1" date="1440.0" midi.pitch="60.0" pitchname="x" accidentals="0.0" octave="3.0" duration="1440.0" />
        <note xml:id="a2" date="1440.0" midi.pitch="64.0" pitchname="x" accidentals="0.0" octave="3.0" duration="1440.0" />
        <note xml:id="a3" date="1440.0" midi.pitch="67.0" pitchname="x" accidentals="0.0" octave="3.0" duration="1440.0" />
        <note xml:id="b1" date="2880.0" midi.pitch="62.0" pitchname="x" accidentals="0.0" octave="3.0" duration="1440.0" />
        <note xml:id="b2" date="2880.0" midi.pitch="65.0" pitchname="x" accidentals="0.0" octave="3.0" duration="1440.0" />
        <note xml:id="b3" date="2880.0" midi.pitch="69.0" pitchname="x" accidentals="0.0" octave="3.0" duration="1440.0" />
      </score>
    </dated>
  </part>
</msm>
