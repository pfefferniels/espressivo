<?xml version="1.0"?>
<!--
  spec-derived, MPM develop @ 1de00bb, the lenient reading, arithmetic in
  ornamentation-v3.test.ts

  Hand-authored (NOT generated by the Java reference, which has no v3 support).

  THE POINT OF THIS FIXTURE. The v3 schematron demands a unit suffix on every frame value,
  and the format's own corpus — including the MPM repository's sample encodings and the ODD's
  own examples — does not write one; it states the unit once, on the element, as the legacy
  `time.unit` attribute that v3 dropped. The reader accepts all of it
  and the writer emits canonical v3, so a document written against the older habit still
  plays. Every other fixture here is spelled canonically; this one is spelled the way real
  documents are, and its three ornaments are the three lenient readings:

    legacyMs     time.unit="milliseconds" + suffix-less values ⇒ both values milliseconds.
                 Deliberately the same def as `spread-ms`, so "the legacy spelling changes
                 nothing" is a comparison and not a claim: markers −30 / −15 / +30.
    legacyTicks  suffix-less values with NO time.unit at all ⇒ ticks, the default, which
                 is what every real corpus file means. Read as milliseconds instead, this
                 ornament would produce markers rather than dates — a visibly different
                 document, which is what makes the reading worth pinning.
    legacyAlias  frame.start, v2's name for frame.offset, read as the alias. The element is
                 v3 by the "%" on frameLength alone: a suffix anywhere is a v3 marker, and
                 the alias then carries the offset with the fallback domain (ticks here).

  120 bpm on a quarter beat at ppq 720 makes one quarter 500 ms, so one tick is 500/720 ms.
-->
<mpm xmlns="http://www.cemfi.de/mpm/ns/1.0">
  <performance name="v3 legacy time.unit and suffix-less values" pulsesPerQuarter="720">
    <global>
      <header>
        <ornamentationStyles>
          <styleDef name="orn style">
            <ornamentDef name="legacyTicks">
              <temporalSpread frame.offset="0" frameLength="360" />
            </ornamentDef>
            <ornamentDef name="legacyAlias">
              <temporalSpread frame.start="180" frameLength="50%" />
            </ornamentDef>
            <ornamentDef name="legacyMs">
              <temporalSpread time.unit="milliseconds" frame.offset="-30" frameLength="60" intensity="2.0" noteoff.shift="true" />
            </ornamentDef>
          </styleDef>
        </ornamentationStyles>
      </header>
      <dated>
        <tempoMap>
          <tempo date="0.0" bpm="120" beatLength="0.25" />
        </tempoMap>
        <ornamentationMap>
          <style date="0.0" name.ref="orn style" />
          <ornament date="0.0" name.ref="legacyTicks" noteid="#B" note.order="#B #u1" xml:id="ornTicks">
            <note xml:id="u1" interval.chromatic="2.0" />
          </ornament>
          <ornament date="1440.0" name.ref="legacyAlias" noteid="#C" note.order="#C #d1" xml:id="ornAlias">
            <note xml:id="d1" interval.chromatic="1.0" />
          </ornament>
          <ornament date="2880.0" name.ref="legacyMs" noteid="#A" note.order="#A #n2 #n3" xml:id="ornMsLegacy">
            <note xml:id="n2" interval.chromatic="3.0" />
            <note xml:id="n3" interval.chromatic="7.0" />
          </ornament>
        </ornamentationMap>
      </dated>
    </global>
    <part name="Piano" number="1" midi.channel="0" midi.port="0">
      <header />
      <dated>
        <dynamicsMap>
          <dynamics date="0.0" volume="100" />
        </dynamicsMap>
      </dated>
    </part>
  </performance>
</mpm>
