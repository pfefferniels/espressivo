<?xml version="1.0"?>
<!--
  spec-derived, MPM develop @ 1de00bb, DESIGN.md D8 (interval.diatonic), arithmetic in
  ornamentation-v3.test.ts

  Hand-authored (NOT generated by the Java reference, which has no v3 support). The pool
  states its pitches as scale steps, which the spec calls only "context-sensitive": DESIGN.md
  D8 resolves them against the MSM key signature in force at the ornament's date, which is
  what makes this pair a fixture rather than a unit test — the key lives in the MSM and the
  steps live in the MPM.

  down = one scale step below D5, up = two above, up8 = a full octave (seven steps) above.

  120 bpm on a quarter beat makes 720 ticks 500 ms.
-->
<mpm xmlns="http://www.cemfi.de/mpm/ns/1.0">
  <performance name="v3 diatonic turn" pulsesPerQuarter="720">
    <global>
      <header>
        <ornamentationStyles>
          <styleDef name="orn style">
            <ornamentDef name="diatonicTurn">
              <temporalSpread frame.offset="0.0ticks" frameLength="50%" noteoff.shift="monophonic" />
            </ornamentDef>
          </styleDef>
        </ornamentationStyles>
      </header>
      <dated>
        <tempoMap>
          <tempo date="0.0" bpm="120" beatLength="0.25" />
        </tempoMap>
        <ornamentationMap>
          <style date="0.0" name.ref="orn style" />
          <ornament date="0.0" name.ref="diatonicTurn" noteid="#P" note.order="#down #P #up #up8" xml:id="ornDia">
            <note xml:id="down" interval.diatonic="-1" />
            <note xml:id="up" interval.diatonic="2" />
            <note xml:id="up8" interval.diatonic="7" />
          </ornament>
        </ornamentationMap>
      </dated>
    </global>
    <part name="Piano" number="1" midi.channel="0" midi.port="0">
      <header />
      <dated>
        <dynamicsMap>
          <dynamics date="0.0" volume="100" />
        </dynamicsMap>
      </dated>
    </part>
  </performance>
</mpm>
