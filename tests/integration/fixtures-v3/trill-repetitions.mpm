<?xml version="1.0"?>
<!--
  spec-derived, MPM develop @ 1de00bb, a worked vector, arithmetic in ornamentation-v3.test.ts

  Hand-authored (NOT generated by the Java reference, which has no v3 support). The spec's own
  figure-3 exemplum: a repeat group played repetitions + 1 = 4 times inside a frame whose
  offset is stated in ticks while its length is stated as a percentage — the mixed-domain case
  the reader makes legal (both resolve into ticks).

  120 bpm on a quarter beat makes 720 ticks 500 ms.
-->
<mpm xmlns="http://www.cemfi.de/mpm/ns/1.0">
  <performance name="v3 trill" pulsesPerQuarter="720">
    <global>
      <header>
        <ornamentationStyles>
          <styleDef name="orn style">
            <ornamentDef name="trill">
              <temporalSpread frame.offset="360ticks" frameLength="50%" />
            </ornamentDef>
          </styleDef>
        </ornamentationStyles>
      </header>
      <dated>
        <tempoMap>
          <tempo date="0.0" bpm="120" beatLength="0.25" />
        </tempoMap>
        <ornamentationMap>
          <style date="0.0" name.ref="orn style" />
          <ornament date="0.0" name.ref="trill" noteid="#P" note.order="|: #n1 #P :|" repetitions="3" xml:id="orn3">
            <note xml:id="n1" interval.chromatic="1.0" />
          </ornament>
        </ornamentationMap>
      </dated>
    </global>
    <part name="Piano" number="1" midi.channel="0" midi.port="0">
      <header />
      <dated>
        <dynamicsMap>
          <dynamics date="0.0" volume="100" />
        </dynamicsMap>
      </dated>
    </part>
  </performance>
</mpm>
