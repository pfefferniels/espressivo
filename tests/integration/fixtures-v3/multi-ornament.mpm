<?xml version="1.0"?>
<!--
  spec-derived, MPM develop @ 1de00bb, DESIGN.md D11 (multi-ornament layout), arithmetic in
  ornamentation-v3.test.ts

  Hand-authored (NOT generated by the Java reference, which has no v3 support). Two ornaments
  on one principal, one aligned at each end and both in the tick domain, so that a single
  layout pass has to place them: the front one from the principal's start, the back one packed
  against its end, and both scaled down by the same factor because 100% + 50% does not fit
  into 100% of the note.

  The two noteoff.shift modes differ on purpose — the front figure ties into what follows
  (monophonic), the back one keeps the principal's length on every note (true) — so the
  fixture pins both against one layout.

  120 bpm on a quarter beat makes 720 ticks 500 ms.
-->
<mpm xmlns="http://www.cemfi.de/mpm/ns/1.0">
  <performance name="v3 two ornaments" pulsesPerQuarter="720">
    <global>
      <header>
        <ornamentationStyles>
          <styleDef name="orn style">
            <ornamentDef name="front" alignment="at start">
              <temporalSpread frame.offset="0.0ticks" frameLength="100%" noteoff.shift="monophonic" />
            </ornamentDef>
            <ornamentDef name="back" alignment="at end">
              <temporalSpread frame.offset="0.0ticks" frameLength="50%" noteoff.shift="true" />
            </ornamentDef>
          </styleDef>
        </ornamentationStyles>
      </header>
      <dated>
        <tempoMap>
          <tempo date="0.0" bpm="120" beatLength="0.25" />
        </tempoMap>
        <ornamentationMap>
          <style date="0.0" name.ref="orn style" />
          <ornament date="0.0" name.ref="front" noteid="#P" note.order="#n1 #P" xml:id="ornFront">
            <note xml:id="n1" interval.chromatic="1.0" />
          </ornament>
          <ornament date="0.0" name.ref="back" noteid="#P" note.order="#n1 #P" xml:id="ornBack">
            <note xml:id="n1" interval.chromatic="1.0" />
          </ornament>
        </ornamentationMap>
      </dated>
    </global>
    <part name="Piano" number="1" midi.channel="0" midi.port="0">
      <header />
      <dated>
        <dynamicsMap>
          <dynamics date="0.0" volume="100" />
        </dynamicsMap>
      </dated>
    </part>
  </performance>
</mpm>
