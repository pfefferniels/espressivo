<?xml version="1.0"?>
<!--
  spec-derived, MPM develop @ 1de00bb, DESIGN.md D3 (lenient reading), arithmetic in
  ornamentation-v3.test.ts

  Hand-authored (NOT generated by the Java reference, which has no v3 support). Structural
  idiom copied from tests/integration/fixtures/all-maps-reference/ornamentation.msm.

  Three principals, one per lenient reading its `.mpm` twin exercises, laid out so that no
  two of them overlap and each ornament's arithmetic can be read on its own:

    B   [0, 720)      pitch 60 — the suffix-less value with no time.unit at all
    C   [1440, 2160)  pitch 72 — the frame.start alias
    pre [2160, 2880)  pitch 55 — untouched, the control note no ornament names
    A   [2880, 4320)  pitch 64 — the legacy time.unit="milliseconds" fallback

  A sits at the same date and pitch as `spread-ms`'s principal on purpose: its ornament is
  that fixture's def written the legacy way, so the two must produce the same markers.
-->
<msm title="v3 legacy time.unit and suffix-less values" xml:id="v3-legacy-timeunit" pulsesPerQuarter="720">
  <global>
    <header />
    <dated>
      <timeSignatureMap />
      <keySignatureMap />
      <markerMap />
      <sectionMap>
        <section date="0.0" date.end="4320.0" xml:id="sec1" />
      </sectionMap>
      <phraseMap />
      <sequencingMap />
      <pedalMap />
      <miscMap />
    </dated>
  </global>
  <part name="Piano" number="1" midi.channel="0" midi.port="0">
    <header />
    <dated>
      <timeSignatureMap>
        <timeSignature date="0.0" numerator="4.0" denominator="4" />
      </timeSignatureMap>
      <keySignatureMap />
      <markerMap />
      <sequencingMap />
      <pedalMap />
      <phraseMap />
      <miscMap>
        <tupletSpanMap />
      </miscMap>
      <score>
        <note xml:id="B" date="0.0" midi.pitch="60.0" pitchname="x" accidentals="0.0" octave="3.0" duration="720.0" />
        <note xml:id="C" date="1440.0" midi.pitch="72.0" pitchname="x" accidentals="0.0" octave="4.0" duration="720.0" />
        <note xml:id="pre" date="2160.0" midi.pitch="55.0" pitchname="x" accidentals="0.0" octave="2.0" duration="720.0" />
        <note xml:id="A" date="2880.0" midi.pitch="64.0" pitchname="x" accidentals="0.0" octave="3.0" duration="1440.0" />
      </score>
    </dated>
  </part>
</msm>
