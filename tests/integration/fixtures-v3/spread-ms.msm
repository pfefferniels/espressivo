<?xml version="1.0"?>
<!--
  spec-derived, MPM develop @ 1de00bb, a worked vector, arithmetic in ornamentation-v3.test.ts

  Hand-authored (NOT generated by the Java reference, which has no v3 support). Structural
  idiom copied from tests/integration/fixtures/all-maps-reference/ornamentation.msm, whose
  `spreadMs` chord this fixture mirrors: P sits at the same date (2880 ticks = 2000 ms at
  120 bpm) and carries the same pitch as that chord's lowest note, and the v3 note pool
  regenerates the other two (64 + 3 = 67, 64 + 7 = 71).

  `pre` is an untouched note before it, so the millisecond markers can be read against a
  neighbour whose milliseconds are plain tempo arithmetic.
-->
<msm title="v3 millisecond spread" xml:id="v3-spread-ms" pulsesPerQuarter="720">
  <global>
    <header />
    <dated>
      <timeSignatureMap />
      <keySignatureMap />
      <markerMap />
      <sectionMap>
        <section date="0.0" date.end="4320.0" xml:id="sec1" />
      </sectionMap>
      <phraseMap />
      <sequencingMap />
      <pedalMap />
      <miscMap />
    </dated>
  </global>
  <part name="Piano" number="1" midi.channel="0" midi.port="0">
    <header />
    <dated>
      <timeSignatureMap>
        <timeSignature date="0.0" numerator="4.0" denominator="4" />
      </timeSignatureMap>
      <keySignatureMap />
      <markerMap />
      <sequencingMap />
      <pedalMap />
      <phraseMap />
      <miscMap>
        <tupletSpanMap />
      </miscMap>
      <score>
        <note xml:id="pre" date="1440.0" midi.pitch="60.0" pitchname="x" accidentals="0.0" octave="3.0" duration="1440.0" />
        <note xml:id="P" date="2880.0" midi.pitch="64.0" pitchname="x" accidentals="0.0" octave="3.0" duration="1440.0" />
      </score>
    </dated>
  </part>
</msm>
