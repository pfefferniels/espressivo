<?xml version="1.0"?>
<!--
  spec-derived, MPM develop @ 1de00bb, the end-aligned millisecond vector, arithmetic in ornamentation-v3.test.ts

  Hand-authored (NOT generated by the Java reference, which has no v3 support). The one
  combination the original design could not express: a millisecond frame aligned "at end". Its
  anchor is the principal's millisecond END, which does not exist before the tempo pass, so
  phase N writes the end-anchored marker instead of an onset offset.

  This is also the fixture for the head loss that combination costs: the principal cannot be
  carved before its milliseconds are known, so it is removed whole and the renderer says so.

  noteoff.shift is deliberately absent (i.e. false), so the millisecond pass leaves each
  note's end where it was and the duration absorbs the shift.
-->
<mpm xmlns="http://www.cemfi.de/mpm/ns/1.0">
  <performance name="v3 millisecond spread at end" pulsesPerQuarter="720">
    <global>
      <header>
        <ornamentationStyles>
          <styleDef name="orn style">
            <ornamentDef name="spreadMsEnd" alignment="at end">
              <temporalSpread frame.offset="-30.0ms" frameLength="60.0ms" intensity="2.0" />
            </ornamentDef>
          </styleDef>
        </ornamentationStyles>
      </header>
      <dated>
        <tempoMap>
          <tempo date="0.0" bpm="120" beatLength="0.25" />
        </tempoMap>
        <ornamentationMap>
          <style date="0.0" name.ref="orn style" />
          <ornament date="2880.0" name.ref="spreadMsEnd" noteid="#P" note.order="#P #n2 #n3" xml:id="ornMsEnd">
            <note xml:id="n2" interval.chromatic="3.0" />
            <note xml:id="n3" interval.chromatic="7.0" />
          </ornament>
        </ornamentationMap>
      </dated>
    </global>
    <part name="Piano" number="1" midi.channel="0" midi.port="0">
      <header />
      <dated>
        <dynamicsMap>
          <dynamics date="0.0" volume="100" />
        </dynamicsMap>
      </dated>
    </part>
  </performance>
</mpm>
