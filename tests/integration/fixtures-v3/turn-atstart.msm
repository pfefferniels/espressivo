<?xml version="1.0"?>
<!--
  spec-derived, MPM develop @ 1de00bb, a worked vector, arithmetic in ornamentation-v3.test.ts

  Hand-authored (NOT generated by the Java reference, which has no v3 support). Structural
  idiom copied from tests/integration/fixtures/all-maps-reference/ornamentation.msm.

  P is the principal of the figure-1 turn; q and r are untouched neighbours that prove the
  ornament reaches exactly the note it names.
-->
<msm title="v3 turn at start" xml:id="v3-turn-atstart" pulsesPerQuarter="720">
  <global>
    <header />
    <dated>
      <timeSignatureMap />
      <keySignatureMap />
      <markerMap />
      <sectionMap>
        <section date="0.0" date.end="2880.0" xml:id="sec1" />
      </sectionMap>
      <phraseMap />
      <sequencingMap />
      <pedalMap />
      <miscMap />
    </dated>
  </global>
  <part name="Piano" number="1" midi.channel="0" midi.port="0">
    <header />
    <dated>
      <timeSignatureMap>
        <timeSignature date="0.0" numerator="4.0" denominator="4" />
      </timeSignatureMap>
      <keySignatureMap />
      <markerMap />
      <sequencingMap />
      <pedalMap />
      <phraseMap />
      <miscMap>
        <tupletSpanMap />
      </miscMap>
      <score>
        <note xml:id="P" date="0.0" midi.pitch="64.0" pitchname="x" accidentals="0.0" octave="3.0" duration="1440.0" />
        <note xml:id="q" date="1440.0" midi.pitch="67.0" pitchname="x" accidentals="0.0" octave="3.0" duration="720.0" />
        <note xml:id="r" date="2160.0" midi.pitch="65.0" pitchname="x" accidentals="0.0" octave="3.0" duration="720.0" />
      </score>
    </dated>
  </part>
</msm>
