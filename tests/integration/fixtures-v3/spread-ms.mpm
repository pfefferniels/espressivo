<?xml version="1.0"?>
<!--
  spec-derived, MPM develop @ 1de00bb, DESIGN.md §5 vector 5, arithmetic in ornamentation-v3.test.ts

  Hand-authored (NOT generated by the Java reference, which has no v3 support). The v2
  `spreadMs` def of the committed all-maps ornamentation fixture, re-authored in v3 syntax:
  `frame.start="-30.0" frameLength="60.0" time.unit="milliseconds"` becomes per-value unit
  suffixes, and the chord it spread becomes a generated one (note pool + note.order).

  The point of the vector is that this changes nothing about the markers: DESIGN.md D5's
  phase N feeds the unchanged v2 millisecond engine, so the offsets are the same −30 / −15 /
  +30 the Java reference wrote for that chord.

  120 bpm on a quarter beat makes 720 ticks 500 ms, so the principal sounds 2000..3000 ms.
-->
<mpm xmlns="http://www.cemfi.de/mpm/ns/1.0">
  <performance name="v3 millisecond spread" pulsesPerQuarter="720">
    <global>
      <header>
        <ornamentationStyles>
          <styleDef name="orn style">
            <ornamentDef name="spreadMs">
              <dynamicsGradient transition.from="-0.5" transition.to="0.5" />
              <temporalSpread frame.offset="-30.0ms" frameLength="60.0ms" intensity="2.0" noteoff.shift="true" />
            </ornamentDef>
          </styleDef>
        </ornamentationStyles>
      </header>
      <dated>
        <tempoMap>
          <tempo date="0.0" bpm="120" beatLength="0.25" />
        </tempoMap>
        <ornamentationMap>
          <style date="0.0" name.ref="orn style" />
          <ornament date="2880.0" name.ref="spreadMs" noteid="#P" scale="2.0" note.order="#P #n2 #n3" xml:id="ornMs">
            <note xml:id="n2" interval.chromatic="3.0" />
            <note xml:id="n3" interval.chromatic="7.0" />
          </ornament>
        </ornamentationMap>
      </dated>
    </global>
    <part name="Piano" number="1" midi.channel="0" midi.port="0">
      <header />
      <dated>
        <dynamicsMap>
          <dynamics date="0.0" volume="100" />
        </dynamicsMap>
      </dated>
    </part>
  </performance>
</mpm>
