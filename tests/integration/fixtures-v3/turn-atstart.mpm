<?xml version="1.0"?>
<!--
  spec-derived, MPM develop @ 1de00bb, a worked vector, arithmetic in ornamentation-v3.test.ts

  Hand-authored (NOT generated by the Java reference, which has no v3 support). Canonical v3
  syntax: unit suffixes on both frame values, alignment on the ornamentDef, a note pool of
  <note> children, and note.order naming pool ids and the principal.

  The tempo of 120 bpm on a quarter beat makes 720 ticks 500 ms, which is what lets the
  millisecond assertions be computed by hand.
-->
<mpm xmlns="http://www.cemfi.de/mpm/ns/1.0">
  <performance name="v3 turn at start" pulsesPerQuarter="720">
    <global>
      <header>
        <ornamentationStyles>
          <styleDef name="orn style">
            <ornamentDef name="turn" alignment="at start">
              <temporalSpread frame.offset="0.0ticks" frameLength="50%" noteoff.shift="monophonic" />
            </ornamentDef>
          </styleDef>
        </ornamentationStyles>
      </header>
      <dated>
        <tempoMap>
          <tempo date="0.0" bpm="120" beatLength="0.25" />
        </tempoMap>
        <ornamentationMap>
          <style date="0.0" name.ref="orn style" />
          <ornament date="0.0" name.ref="turn" noteid="#P" note.order="#n2 #P #n3 #P" xml:id="orn1">
            <note xml:id="n2" interval.chromatic="1.0" />
            <note xml:id="n3" interval.chromatic="-1.0" />
          </ornament>
        </ornamentationMap>
      </dated>
    </global>
    <part name="Piano" number="1" midi.channel="0" midi.port="0">
      <header />
      <dated>
        <dynamicsMap>
          <dynamics date="0.0" volume="100" />
        </dynamicsMap>
      </dated>
    </part>
  </performance>
</mpm>
