<?xml version="1.0"?>
<!--
  spec-derived, MPM develop @ 1de00bb, DESIGN.md D6 (the v2 path is byte-frozen), arithmetic in
  ornamentation-v3.test.ts

  Hand-authored (NOT generated by the Java reference; see the .msm's header for why this is a
  fresh document rather than a copy of the committed Java-verified pair).

  Pure MPM v2 throughout: `frame.start` rather than `frame.offset`, no unit suffixes, no
  alignment, no note pool, no repetitions, and a note.order that is one of the two v2 pitch
  keywords. Nothing here may take the v3 path.
-->
<mpm xmlns="http://www.cemfi.de/mpm/ns/1.0">
  <performance name="v2 arpeggios" pulsesPerQuarter="720">
    <global>
      <header>
        <ornamentationStyles>
          <styleDef name="orn style">
            <ornamentDef name="arpeggio">
              <dynamicsGradient transition.from="-1.0" transition.to="1.0" />
              <temporalSpread frame.start="-22.0" frameLength="44.0" />
            </ornamentDef>
          </styleDef>
        </ornamentationStyles>
      </header>
      <dated>
        <tempoMap>
          <tempo date="0.0" bpm="120" beatLength="0.25" />
        </tempoMap>
        <ornamentationMap>
          <style date="0.0" name.ref="orn style" />
          <ornament date="1440.0" name.ref="arpeggio" xml:id="ornA" />
          <ornament date="2880.0" name.ref="arpeggio" scale="2.0" note.order="descending pitch" xml:id="ornB" />
        </ornamentationMap>
      </dated>
    </global>
    <part name="Piano" number="1" midi.channel="0" midi.port="0">
      <header />
      <dated>
        <dynamicsMap>
          <dynamics date="0.0" volume="100" />
        </dynamicsMap>
      </dated>
    </part>
  </performance>
</mpm>
