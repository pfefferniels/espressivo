<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0" xml:id="mei-keys-accidentals">
    <meiHead>
        <fileDesc>
            <titleStmt>
                <title>Key Signatures and Accidentals Test</title>
            </titleStmt>
            <pubStmt/>
        </fileDesc>
    </meiHead>
    <music>
        <body>
            <mdiv xml:id="mdiv1">
                <score>
                    <scoreDef>
                        <staffGrp>
                            <staffDef n="1" lines="5" clef.shape="G" clef.line="2" key.sig="3f" meter.count="4" meter.unit="4" label="Piano"/>
                        </staffGrp>
                    </scoreDef>
                    <section xml:id="section1">
                        <measure n="1" xml:id="m1">
                            <staff n="1">
                                <layer n="1">
                                    <note xml:id="n1" pname="e" oct="4" dur="4"/>
                                    <note xml:id="n2" pname="a" oct="4" dur="4" accid="n"/>
                                    <note xml:id="n3" pname="b" oct="4" dur="4"/>
                                    <note xml:id="n4" pname="c" oct="5" dur="4"/>
                                </layer>
                            </staff>
                        </measure>
                        <measure n="2" xml:id="m2">
                            <staff n="1">
                                <layer n="1">
                                    <note xml:id="n5" pname="f" oct="4" dur="4" accid="x"/>
                                    <note xml:id="n6" pname="g" oct="4" dur="4" accid="ff"/>
                                    <note xml:id="n7" pname="a" oct="4" dur="4">
                                        <accid xml:id="ac1" accid="s"/>
                                    </note>
                                    <note xml:id="n8" pname="b" oct="4" dur="4" accid.ges="f"/>
                                </layer>
                            </staff>
                        </measure>
                        <measure n="3" xml:id="m3">
                            <staff n="1">
                                <layer n="1">
                                    <note xml:id="n9" pname="d" oct="5" dur="4" accid="s"/>
                                    <note xml:id="n10" pname="d" oct="5" dur="4"/>
                                    <note xml:id="n11" pname="d" oct="4" dur="4"/>
                                    <note xml:id="n12" pname="e" oct="5" dur="4"/>
                                </layer>
                            </staff>
                        </measure>
                        <scoreDef key.sig="2s"/>
                        <measure n="4" xml:id="m4">
                            <staff n="1">
                                <layer n="1">
                                    <note xml:id="n13" pname="f" oct="4" dur="4"/>
                                    <note xml:id="n14" pname="c" oct="5" dur="4"/>
                                    <note xml:id="n15" pname="g" oct="4" dur="2"/>
                                </layer>
                            </staff>
                        </measure>
                        <measure n="5" xml:id="m5">
                            <staff n="1">
                                <layer n="1">
                                    <note xml:id="n16" pname="d" oct="4" dur="1"/>
                                </layer>
                            </staff>
                        </measure>
                    </section>
                </score>
            </mdiv>
        </body>
    </music>
</mei>
