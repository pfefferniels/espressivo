<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0" xml:id="mei-transposing-octave">
    <meiHead>
        <fileDesc>
            <titleStmt>
                <title>Transposing Instruments and Octave Displacement Test</title>
            </titleStmt>
            <pubStmt/>
        </fileDesc>
    </meiHead>
    <music>
        <body>
            <mdiv xml:id="mdiv1">
                <score>
                    <scoreDef>
                        <staffGrp>
                            <staffDef n="1" lines="5" clef.shape="G" clef.line="2" key.sig="0" meter.count="4" meter.unit="4" label="Clarinet" trans.semi="-2" trans.diat="-1"/>
                            <staffDef n="2" lines="5" clef.shape="F" clef.line="4" key.sig="0" meter.count="4" meter.unit="4" label="Violoncello"/>
                        </staffGrp>
                    </scoreDef>
                    <section xml:id="section1">
                        <measure n="1" xml:id="m1">
                            <staff n="1">
                                <layer n="1">
                                    <note xml:id="n1" pname="c" oct="5" dur="4"/>
                                    <note xml:id="n2" pname="d" oct="5" dur="4"/>
                                    <note xml:id="n3" pname="e" oct="5" dur="4"/>
                                    <note xml:id="n4" pname="f" oct="5" dur="4"/>
                                </layer>
                            </staff>
                            <staff n="2">
                                <layer n="1">
                                    <note xml:id="n5" pname="c" oct="3" dur="2"/>
                                    <note xml:id="n6" pname="d" oct="3" dur="2"/>
                                </layer>
                            </staff>
                            <octave xml:id="oct1" staff="2" dis="8" dis.place="below" tstamp="1" tstamp2="0m+5"/>
                        </measure>
                        <measure n="2" xml:id="m2">
                            <staff n="1">
                                <layer n="1">
                                    <note xml:id="n7" pname="d" oct="5" dur="1"/>
                                </layer>
                            </staff>
                            <staff n="2">
                                <layer n="1">
                                    <note xml:id="n8" pname="e" oct="3" dur="4"/>
                                    <note xml:id="n9" pname="f" oct="3" dur="4"/>
                                    <note xml:id="n10" pname="g" oct="3" dur="2"/>
                                </layer>
                            </staff>
                        </measure>
                        <measure n="3" xml:id="m3">
                            <staff n="1">
                                <layer n="1">
                                    <note xml:id="n11" pname="e" oct="5" dur="2"/>
                                    <note xml:id="n12" pname="c" oct="5" dur="2"/>
                                </layer>
                            </staff>
                            <staff n="2">
                                <layer n="1">
                                    <note xml:id="n13" pname="c" oct="2" dur="1"/>
                                </layer>
                            </staff>
                            <octave xml:id="oct2" staff="1" dis="15" dis.place="above" tstamp="1" tstamp2="0m+3"/>
                        </measure>
                    </section>
                </score>
            </mdiv>
        </body>
    </music>
</mei>
