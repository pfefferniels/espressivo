                        </staffGrp>
                    </scoreDef>
                    <section xml:id="section1">
                        <measure n="1" xml:id="m1">
                            <staff n="1">
                                <layer n="1">
                                    <note xml:id="n1" pname="c" oct="4" dur="4" artic="stacc"/>
                                    <note xml:id="n2" pname="d" oct="4" dur="4" artic="acc"/>
                                    <note xml:id="n3" pname="e" oct="4" dur="4" artic="ten"/>
                                    <note xml:id="n4" pname="f" oct="4" dur="4" artic="marc"/>
                                </layer>
                            </staff>
                        </measure>
                        <measure n="2" xml:id="m2">
                            <staff n="1">
                                <layer n="1">
                                    <note xml:id="n5" pname="g" oct="4" dur="4"/>
                                    <note xml:id="n6" pname="a" oct="4" dur="4"/>
                                    <note xml:id="n7" pname="b" oct="4" dur="4"/>
                                    <note xml:id="n8" pname="c" oct="5" dur="4"/>
                                </layer>
                            </staff>
                            <slur xml:id="s1" staff="1" startid="#n5" endid="#n8"/>
                        </measure>
                        <measure n="3" xml:id="m3">
                            <staff n="1">
                                <layer n="1">
                                    <note xml:id="n9" pname="d" oct="5" dur="4" artic="stacciss"/>
                                    <note xml:id="n10" pname="c" oct="5" dur="4"/>
                                    <note xml:id="n11" pname="b" oct="4" dur="4"/>
                                    <note xml:id="n12" pname="a" oct="4" dur="4"/>
                                </layer>
