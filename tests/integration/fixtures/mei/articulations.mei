<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0" xml:id="mei-artic">
    <meiHead>
        <fileDesc>
            <titleStmt>
                <title>Articulations Test</title>
            </titleStmt>
            <pubStmt/>
        </fileDesc>
    </meiHead>
    <music>
        <body>
            <mdiv xml:id="mdiv1">
                <score>
                    <scoreDef>
                        <staffGrp>
