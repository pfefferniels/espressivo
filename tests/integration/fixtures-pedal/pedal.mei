<?xml version="1.0" encoding="UTF-8"?>
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0" xml:id="mei-pedal">
    <meiHead>
        <fileDesc>
            <titleStmt>
                <title>Pedal</title>
            </titleStmt>
            <pubStmt/>
        </fileDesc>
    </meiHead>
    <music>
        <body>
            <mdiv xml:id="mdiv1">
                <score>
                    <scoreDef>
                        <staffGrp>
                            <staffDef n="1" lines="5" clef.shape="G" clef.line="2" key.sig="0" meter.count="4" meter.unit="4"/>
                        </staffGrp>
                    </scoreDef>
                    <section xml:id="section1">
                        <measure n="1" xml:id="m1">
                            <staff n="1">
                                <layer n="1">
                                    <note xml:id="n1" pname="c" oct="4" dur="4"/>
                                    <note xml:id="n2" pname="d" oct="4" dur="4"/>
                                    <note xml:id="n3" pname="e" oct="4" dur="4"/>
                                    <note xml:id="n4" pname="f" oct="4" dur="4"/>
                                </layer>
                            </staff>
                            <!-- down at the bar line, up at beat 3: tstamp form -->
                            <pedal xml:id="ped1" dir="down" tstamp="1"/>
                            <pedal xml:id="ped2" dir="up" tstamp="3"/>
                        </measure>
                        <measure n="2" xml:id="m2">
                            <staff n="1">
                                <layer n="1">
                                    <note xml:id="n5" pname="g" oct="4" dur="4"/>
                                    <note xml:id="n6" pname="a" oct="4" dur="4"/>
                                    <note xml:id="n7" pname="b" oct="4" dur="4"/>
                                    <note xml:id="n8" pname="c" oct="5" dur="4"/>
                                </layer>
                            </staff>
                            <!-- a spanning pedal: start here, end named by @endid in measure 3 -->
                            <pedal xml:id="ped3" dir="down" startid="#n5" endid="#n10"/>
                            <!-- staff-scoped: goes to the part's own pedalMap, not the global one -->
                            <pedal xml:id="ped4" dir="half" tstamp="4" staff="1"/>
                        </measure>
                        <measure n="3" xml:id="m3">
                            <staff n="1">
                                <layer n="1">
                                    <note xml:id="n9" pname="d" oct="5" dur="4"/>
                                    <note xml:id="n10" pname="e" oct="5" dur="4"/>
                                    <note xml:id="n11" pname="f" oct="5" dur="2"/>
                                </layer>
                            </staff>
                            <!-- tstamp2 form: two measures onward -->
                            <pedal xml:id="ped5" dir="down" tstamp="1" tstamp2="1m+3"/>
                        </measure>
                        <measure n="4" xml:id="m4">
                            <staff n="1">
                                <layer n="1">
                                    <note xml:id="n12" pname="g" oct="5" dur="1"/>
                                </layer>
                            </staff>
                        </measure>
                    </section>
                </score>
            </mdiv>
        </body>
    </music>
</mei>
