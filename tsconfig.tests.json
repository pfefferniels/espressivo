{
  // Typecheck-only project covering the test suite, which tsconfig.json excludes.
  // Without this, a type-level breakage in an adapted test can only ever surface as
  // a vitest runtime failure — see the `typecheck:tests` step of `npm run verify`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // `noUncheckedIndexedAccess` is ON for `src/` and deliberately OFF here, for now. It cost
    // 885 errors in `src/` and 1047 in `tests/`, and the two are separate jobs: the source
    // side was cleared by REMOVING the indexing — the algorithms in `src/prelude/seq.ts` —
    // whereas a test that reads `notes[3]` after asserting a length of four is usually saying
    // exactly what it means.
    //
    // Not written off. `scripts/strict-ratchet.mjs` now measures THIS project and `npm run
    // verify` fails if any `tests/` directory gets worse, so the count is monotonic here as it
    // was there. Delete this line, and the ratchet, when it reaches zero.
    "noUncheckedIndexedAccess": false,

    // `tsconfig.json` sets `"types": []` because `src/` uses no ambient global. The tests do —
    // `process.env`, `Buffer`, `__dirname` in the fixture loaders — so they name what they use.
    "types": ["node"],

    // Test files are allowed an unused parameter in a stub callback; `src/` is not.
    "noUnusedParameters": false,

    // Zero cost in `src/`, ~90 findings here. A test that walks a parsed JSON-ish record and
    // asserts `result.meanSigned` is reading a looked-up key on purpose, and bracketing every
    // one of them would obscure the assertion rather than sharpen it.
    "noPropertyAccessFromIndexSignature": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "."
  },
  "include": ["src/**/*", "tests/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "tests/integration/fixtures"]
}
